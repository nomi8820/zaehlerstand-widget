{
  "name": "zaehlerstand-widget",
  "version": "0.1.0",
  "private": true,
  "description": "GASAG Probeaufgabe – Zählerstand-Widget (Starter)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "mock-api": "node mock-api/server.cjs",
    "mock-api:reset": "node mock-api/server.cjs --reset",
    "start": "concurrently -n api,web -c blue,green \"npm:mock-api\" \"npm:dev\"",
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:xml": "node scripts/check-xml.mjs"
  },
  "dependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.4.0",
    "@vue/tsconfig": "^0.9.0",
    "concurrently": "^10.0.0",
    "eslint": "^10.0.0",
    "eslint-plugin-vue": "^10.0.0",
    "jsdom": "^27.0.0",
    "json-server": "0.17.4",
    "typescript": "~5.9.0",
    "vite": "^8.0.0",
    "vitest": "^5.0.0",
    "vue-tsc": "^3.0.0",
    "fast-xml-parser": "^5.0.0"
  }
}
